  "info": {
    "title": "Terra Link API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "organization_type": {
            "type": "string",
            "description": "Código del catálogo provisional D-18 (GET /api/v1/catalog/organization-types)",
            "example": "EXPORTER"
          },
          "tax_id": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "EC"
          },
          "province": {
            "type": "string"
          },
          "canton": {
            "type": "string"
          },
          "parish": {
            "type": "string"
          },
          "initial_admin_email": {
            "type": "string",
            "description": "Usuario existente que recibe ORG_ADMIN"
          }
        },
        "required": [
          "name",
          "organization_type",
          "country"
        ]
      },
      "UpdateOrganizationDto": {
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "number",
            "description": "row_version leída; rechazo 409 si cambió"
          },
          "name": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "tax_id": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "canton": {
            "type": "string"
          },
          "parish": {
            "type": "string"
          }
        },
        "required": [
          "expected_version"
        ]
      },
      "StatusChangeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ReasonDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ChangeRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ORG_ADMIN",
                "MANAGER",
                "FIELD_TECHNICIAN",
                "RECEPTION_OPERATOR",
                "QUALITY_OPERATOR",
                "TRACEABILITY_MANAGER",
                "EUDR_MANAGER",
                "EXPORT_MANAGER",
                "BUYER",
                "AUDITOR",
                "PRODUCER"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "roles",
          "reason"
        ]
      },
      "CreateInvitationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role_code": {
            "type": "string",
            "enum": [
              "ORG_ADMIN",
              "MANAGER",
              "FIELD_TECHNICIAN",
              "RECEPTION_OPERATOR",
              "QUALITY_OPERATOR",
              "TRACEABILITY_MANAGER",
              "EUDR_MANAGER",
              "EXPORT_MANAGER",
              "BUYER",
              "AUDITOR",
              "PRODUCER"
            ]
          }
        },
        "required": [
          "email",
          "role_code"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token del enlace (secreto)"
          }
        },
        "required": [
          "token"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}
