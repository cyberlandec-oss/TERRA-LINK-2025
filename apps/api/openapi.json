  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "organization_type": {
            "type": "string",
            "description": "Código en mayúsculas; catálogo pendiente (D-18)",
            "example": "EXPORTER"
          },
          "tax_id": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "EC"
          },
          "province": {
            "type": "string"
          },
          "canton": {
            "type": "string"
          },
          "parish": {
            "type": "string"
          },
          "initial_admin_email": {
            "type": "string",
            "description": "Usuario existente que recibe ORG_ADMIN"
          }
        },
        "required": [
          "name",
          "organization_type",
          "country"
        ]
      },
      "UpdateOrganizationDto": {
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "number",
            "description": "row_version leída; rechazo 409 si cambió"
          },
          "name": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "tax_id": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "canton": {
            "type": "string"
          },
          "parish": {
            "type": "string"
          }
        },
        "required": [
          "expected_version"
        ]
      },
      "StatusChangeDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      }
    }
