{
  "name": "@terra-link/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "seed:dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/db/seed-dev.js",
    "openapi": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/openapi-export.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --max-warnings 0",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
